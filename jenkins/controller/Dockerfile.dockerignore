# The build context is jenkins/. Include only controller build inputs.
# Local .env, retired keys, plugin caches and agent files never enter the context.
**
!controller/
!controller/Dockerfile
!controller/Dockerfile.dockerignore
!controller/plugins.lock.json
!controller/plugins.txt
!casc/
!casc/jenkins.yaml
!scripts/
!scripts/install-locked-plugins.py
